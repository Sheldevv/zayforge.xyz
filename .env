# ── Database ───────────────────────────────────────────
# PostgreSQL connection string.
# Get a free database from one of these:
#   • Neon     → https://neon.tech        (free tier: 0.5 GB)
#   • Supabase → https://supabase.com      (free tier: 500 MB)
#   • Railway  → https://railway.app       (free tier: $5 credit)
#
# Format: postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/zayforge"

# ── Auth ──────────────────────────────────────────────
# Generate a random 64-char secret: openssl rand -base64 64
JWT_SECRET="zayforge-jwt-secret-change-in-production-2026"

# ── GitHub API (optional, avoids rate limits) ──────────
# Create at: https://github.com/settings/tokens (no scopes needed for public repos)
# GITHUB_TOKEN="ghp_xxxxxxxxxxxx"
